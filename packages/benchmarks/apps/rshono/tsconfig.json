{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "@rshono/core/dist/types/rshono-config.d.ts"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "rshono.config.ts"]
}
